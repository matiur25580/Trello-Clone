PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/trello-clone?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Trello Clone <no-reply@example.com>
