const express = require('express');
const cors = require('cors');

const app = express();
const PORT = 5000;

app.use(cors());
app.use(express.json());

// ইন-মেমোরি বোর্ড লিস্ট (ডেটাবেজের পরিবর্তে)
let boards = [];

// সব বোর্ড গেট করার রুট
app.get('/api/boards', (req, res) => {
  res.json(boards);
});

// নতুন বোর্ড তৈরির রুট
app.post('/api/boards', (req, res) => {
  const { title, description } = req.body;
  if (!title) {
    return res.status(400).json({ error: 'Title is required' });
  }

  const newBoard = {
    _id: Date.now().toString(), // ইউনিক আইডি জেনারেট করার জন্য
    title,
    description: description || 'Created from Alpine Linux MERN app'
  };

  boards.push(newBoard);
  res.status(201).json(newBoard);
});

app.listen(PORT, () => {
  console.log(`Backend Server running on port ${PORT} (Memory Database Mode)`);
});
